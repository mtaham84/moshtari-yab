{
  "log": { "loglevel": "warning" },
  "inbounds": [
    { "tag": "socks", "listen": "0.0.0.0", "port": 1080, "protocol": "socks", "settings": { "udp": true } },
    { "tag": "http", "listen": "0.0.0.0", "port": 8080, "protocol": "http" }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          { "address": "SERVER_ADDRESS", "port": 443,
            "users": [ { "id": "YOUR-UUID", "encryption": "none" } ] }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": { "serverName": "SNI_HOST", "fingerprint": "chrome", "allowInsecure": false },
        "wsSettings": { "path": "/", "headers": { "Host": "WS_HOST" } }
      }
    }
  ]
}
