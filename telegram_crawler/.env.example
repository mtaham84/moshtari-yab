# Telegram API Credentials (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/telegram_crawler_session

# Database
DB_PATH=data/leads.db

# Crawler & Monitor Settings
BACKFILL_HOURS=24
BACKFILL_LIMIT=200
CONTEXT_MSG_COUNT=5

# Target Keywords (comma-separated Persian/English phrases)
TARGET_KEYWORDS="روغن موتور,خریدارم,دنبال,قیمت چنده,سراغ دارید"

# Django Microservice Integration (Webhook)
DJANGO_WEBHOOK_URL=http://localhost:8000/discovery/api/leads/submit/
DJANGO_WEBHOOK_ENABLED=true

