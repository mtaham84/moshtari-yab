# Telegram API Credentials (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/telegram_crawler_session

# Database
DB_PATH=data/leads.db

# Crawler & Monitor Settings
BACKFILL_HOURS=24
BACKFILL_LIMIT=200
CONTEXT_MSG_COUNT=5

# Candidate filter: basic (default: drop only empty/short/bot messages, the agent decides)
# or keyword (legacy: only messages containing TARGET_KEYWORDS)
CRAWLER_FILTER_MODE=basic
MIN_TEXT_CHARS=8
TARGET_KEYWORDS="خریدارم,دنبال,قیمت چنده,سراغ دارید"

# Rate limiting (Telegram FloodWait)
FLOOD_SLEEP_THRESHOLD=60      # Telethon sleeps automatically below this many seconds
FLOOD_MAX_WAIT_SECONDS=900    # longer waits abort the current step
FLOOD_MAX_RETRIES=3
REQUEST_DELAY_SECONDS=0.3     # pause between context-fetch API calls

# Shared analysis inbox (analysis/store.py). The path is ANALYSIS_DB_PATH in the root .env
ANALYSIS_ENQUEUE_ENABLED=true

# Legacy: push raw un-analysed candidates straight to Django (replaced by agent verdicts)
DJANGO_WEBHOOK_URL=http://localhost:8000/discovery/api/leads/submit/
DJANGO_WEBHOOK_ENABLED=false

