# Telegram API credentials (https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/telegram_crawler_session

# PostgreSQL archive (same database as the panel). TG_DATABASE_URL / DATABASE_URL override POSTGRES_*.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=customer_yab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
TG_DB_SCHEMA=crawler

# What is stored
TG_FETCH_PROFILES=true        # bio of each new user, once (users.GetFullUser), slowly
TG_PROFILE_DELAY_SECONDS=3
TG_PARENT_DEPTH=3             # fetch replied-to messages older than the backfill window, up to N levels
TG_STORE_RAW=true             # full Telethon object as jsonb (raw) next to the parsed columns

# History archived when a group is added
BACKFILL_HOURS=24
BACKFILL_LIMIT=200

# Rate limiting (Telegram FloodWait)
FLOOD_SLEEP_THRESHOLD=60      # Telethon sleeps automatically below this many seconds
FLOOD_MAX_WAIT_SECONDS=900    # longer waits abort the current step
FLOOD_MAX_RETRIES=3
REQUEST_DELAY_SECONDS=0.3     # pause between group joins
