# ---------------------------------------------------------------------------
# Django panel
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SHOW_DEMO_ACCOUNTS=false
# Optional password for new demo accounts; otherwise a random one is generated if any account is new.
DEMO_ACCOUNTS_PASSWORD=
DJANGO_BEHIND_HTTPS_PROXY=false
DJANGO_FORCE_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
# Enable HSTS only after HTTPS is working for this domain and its subdomains.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_REFERRER_POLICY=same-origin
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
FIELD_ENCRYPTION_KEY=
DATA_RETENTION_DAYS=180
COLLECTOR_STATE_BACKEND=sqlite
TG_HEARTBEAT_INTERVAL_SECONDS=60
RETENTION_REPORT_INTERVAL_HOURS=168
RETENTION_REPORT_FILE=output/retention_report.json
POSTGRES_DB=customer_yab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# One PostgreSQL (with pgvector) for Django, crawler and need_engine. Docker sets POSTGRES_HOST=db.
# Docker / production
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=moshtariyab.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://moshtariyab.example.com
# DJANGO_BEHIND_HTTPS_PROXY=true
# DJANGO_SEED_DEMO=false
# WEB_PORT=8000
# GUNICORN_WORKERS=3

# ---------------------------------------------------------------------------
# Telegram crawler (telegram_crawler/) — archive only, API_ID/HASH from https://my.telegram.org
# Writes schema "crawler": tg_users, tg_chats, tg_messages (uses the POSTGRES_* settings above)
# ---------------------------------------------------------------------------
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/telegram_crawler_session
TG_DB_SCHEMA=crawler
BACKFILL_HOURS=24
BACKFILL_LIMIT=200
# bio of every new user, fetched once and slowly (users.GetFullUser); parents of replies up to N levels
TG_FETCH_PROFILES=true
TG_PROFILE_DELAY_SECONDS=3
TG_PARENT_DEPTH=3
TG_STORE_RAW=true
# groups to watch are read from the panel («جوامع آنلاین») every N seconds
TG_PANEL_COMMUNITIES=true
TG_PANEL_POLL_SECONDS=30
# no direct access to Telegram (servers inside Iran): run the "xray" service (docker compose --profile proxy …)
# TG_PROXY=socks5://xray:1080            # also http://host:port or mtproxy://<secret>@host:port
# joins are queued: at least N seconds between two joins (FloodWait pushes the queue further); max distinct groups per account
TG_JOIN_INTERVAL_SECONDS=60
TG_MAX_GROUPS=100
# a seller may add up to N private sources in the panel (global sources: admin / manage.py seed_global_sources)
TG_MAX_PRIVATE_SOURCES=5

# ---------------------------------------------------------------------------
# need_engine — the only analysis pipeline (full list: need_engine/config.py, NE_<FIELD>)
# Reads crawler + Django tables read-only; writes only schema "need_engine" (state, pgvector, opportunities)
# ---------------------------------------------------------------------------
NE_LLM_API_KEY=
# LLM / embeddings through the same proxy (Python urllib reads these lowercase vars in Linux); keep internal hosts direct
# HTTPS_PROXY=http://xray:8080
# https_proxy=http://xray:8080
# http_proxy=http://xray:8080
# NO_PROXY=localhost,127.0.0.1,db,web
# no_proxy=localhost,127.0.0.1,db,web
NE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
NE_EXTRACT_MODEL=gemini-3.5-flash-lite
NE_VERIFY_MODEL=gemini-3.5-flash-lite
NE_REPLY_MODEL=gemini-3.5-flash-lite
NE_EMBED_BACKEND=gemini
NE_USD_TO_TOMAN=100000
# Providers, models, prices, USD rate and wallets are managed in the admin panel (/ops/); the NE_* values above are
# only the fallback when the panel has nothing for a role. The engine re-reads the panel every N seconds.
# NE_MODEL_REGISTRY=true
# NE_REGISTRY_TTL=60
# NE_RELEASE_BATCH=200   # queued («در انتظار پرداخت») needs re-matched per seller per run after a top-up
NE_MESSAGES_SOURCE=db
NE_PRODUCTS_SOURCE=db
NE_CRAWLER_SCHEMA=crawler
NE_STATE_SCHEMA=need_engine
# analyse a group every N new messages (count only, no waiting for the chat to go quiet)
NE_TRIGGER_COUNT=50
# public address of the panel; links in reply drafts are <this>/r/<product>/?ref=<opportunity> → the seller's own page
NE_PUBLIC_BASE_URL=http://localhost:8000
# which sellers see a chat: GLOBAL source → all, PRIVATE → its owners, none → not analysed ("open" disables the rule)
NE_SOURCE_ACCESS=panel
NE_COMMUNITIES_TABLE=public.discovery_monitoredcommunity
NE_X_ENABLED=false
NE_X_MAX_PER_RUN=200
NE_X_INGEST_MAX_PER_RUN=2000
NE_X_PROCESS_ORDER=newest
NE_X_MAX_POST_AGE_HOURS=168
NE_X_NEED_TTL_HOURS=168
NE_X_FRESHNESS_HALFLIFE_HOURS=12
NE_X_REFRESH_BATCH_SIZE=200
NE_X_MIN_MATCH_SCORE=65
# فیلتر X: shadow فقط تصمیم‌های احتمالی را می‌شمارد؛ on واقعاً رد می‌کند.
NE_X_PREFILTER=shadow
# false: فقط نویسنده‌هایی که LLM «individual» تشخیص دهد (اکثر کاربران بیو ندارند و unknown می‌شوند)
NE_X_ALLOW_UNKNOWN_AUTHOR=true
NE_X_MIN_CHARS=15
NE_X_MIN_PERSIAN_RATIO=0.5
NE_X_ALLOW_FINGLISH=true
NE_X_MIN_RELEVANCE=0.05
NE_X_MAX_POSTS_PER_AUTHOR_PER_RUN=3
NE_X_BATCH_SIZE=8
NE_X_BATCH_MAX_CHARS=6000
NE_X_REPLY_TOP_N=1
NE_X_REPLY_MAX_CHARS=280
NE_X_PUBLIC_TARGET_CHARS=240
NE_X_DEDUP_DAYS=7
NE_X_DEDUP_THRESHOLD=0.8
X_INTENT_BASE_URL=https://x.com/intent/post

# ---------------------------------------------------------------------------
# X collector (workers/x_collector/) — experimental, read-only
# Cookie auth carries ban risk: use a dedicated burner account only.
# ---------------------------------------------------------------------------
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
X_CLI_CMD=twitter
# هر query به شکل (نام۱ OR "نام دو کلمه‌ای" …) (بخرم OR میخوام OR پیشنهاد …) lang:fa ساخته می‌شود.
# intent: نام‌ها + واژه‌های خرید | both: به‌علاوهٔ query برند/مدل (مثل "Airfly M7") | product: رفتار قدیمی (عنوان/دسته خام)
X_QUERY_MODE=both
# true: LLM برای هر محصول نام‌های رایج، مشکل‌ها به زبان خریدار و برند/مدل می‌نویسد (یک بار برای هر نسخهٔ محصول/کارت، در kv کش می‌شود)
X_QUERY_LLM=false
X_QUERY_LLM_BATCH=15
# عملگرهایی که به همهٔ queryها اضافه می‌شوند؛ -filter:links آگهی‌ها را کم می‌کند ولی پست‌های عکس‌دار را هم حذف می‌کند
X_QUERY_OPERATORS=lang:fa
# true: واژه‌های منفی اضافه می‌شوند (پیش‌فرض: تخفیف، "ارسال رایگان"، "کد تخفیف"، "فروش ویژه"؛ یا لیست با کاما در X_QUERY_NEGATIVE_TERMS)
X_QUERY_NEGATIVE_TERMS=
X_QUERY_SUFFIX=
X_QUERY_MAX_CHARS=400
# بازهٔ زمانی هر جست‌وجو: since_time (پیش‌فرض، دقیق) | since (روزانه، رسمی) | off
# اولین اجرای هر query (مثلاً محصول تازه) X_QUERY_FIRST_LOOKBACK_HOURS ساعت به عقب می‌رود؛ بعد از آخرین اجرای موفق ادامه می‌دهد.
X_QUERY_TIME_FILTER=since_time
X_QUERY_FIRST_LOOKBACK_HOURS=168
X_QUERY_OVERLAP_MINUTES=10
X_QUERY_MAX_PER_PRODUCT=12
X_COLLECT_QUERIES_PER_CYCLE=12
# seconds between collection cycles of `docker compose --profile x up -d x`
X_COLLECT_INTERVAL_SECONDS=300
# load each cycle's new posts into the database right away (no manual `python -m x_ingest`)
X_AUTO_INGEST=true
# SearchTimeline request method: auto (GET, on 404 POST) | get | post
TWITTER_SEARCH_METHOD=auto
# product (default): only products whose seller turned «جستجوی مشتری در X» on are searched — each product with its own
# queries and its own analysis, billed in full to that seller | public: one generic search, platform pays | both
NE_X_MODE=product
# fee per X search charged to the sellers of the searched products (toman; 0 = free; markup applies)
X_SEARCH_FEE_TOMAN=0
# queries per product (names × buying cues, problems)
X_QUERY_MAX_PER_PRODUCT_TARGETED=4
# characters of the author's bio sent to the LLM (spots shops)
NE_X_BIO_CHARS=120
X_CLI_TIMEOUT=45
# Optional static query override; otherwise live collector builds queries from active products/categories.
X_COLLECT_QUERIES_FILE=
X_COLLECT_OUTPUT_DIR=data/x_collected
X_COLLECT_STATE_FILE=output/x_collector_state.sqlite3
X_COLLECT_MAX_PER_QUERY=50
X_COLLECT_DAILY_CAP=500
X_COLLECT_SLEEP_MIN=2
X_COLLECT_SLEEP_MAX=5
X_COLLECT_MAX_RETRIES=3
X_COLLECT_CIRCUIT_BREAKER=4
# seller pages «جستجوی مشتری در X» (switch per product + activity report); false hides them
X_SELLER_UI=true
X_PANEL_ENABLED=false
X_QUERY_SOURCE=generated
X_QUERY_NEGATIVE_OPERATORS=false
X_MANUAL_QUERIES_MAX=30
X_NEGATIVE_TERMS_MAX=50
X_STATUS_FILE=data/x_collected/status.json
X_STATUS_STALE_MINUTES=30
X_QUERY_AUTOPAUSE=false
X_QUERY_MIN_FETCHED=150
X_QUERY_MIN_DAYS=7
X_QUERY_SUGGEST=false
X_QUERY_SUGGEST_PER_WEEK=10
X_QUERY_AUTO_ACCEPT=false
X_SCORE_PRIOR_P0=0.03
X_SCORE_PRIOR_N0=30
X_CONTACT_EXTRACT=true
X_CONTACT_TYPES=telegram,instagram,website
X_CONTACT_LINK_TELEGRAM=true
NE_X_THREAD_REPLIES=false
NE_X_THREAD_MIN_MATCH_SCORE=70
X_THREAD_COLLECT=false
X_THREAD_STRATEGY=search
X_CLI_THREAD_SUBCOMMAND=
X_THREAD_DAILY_REQUESTS=50
X_THREAD_MAX_REPLIES=40
X_THREAD_MIN_AGE_MINUTES=20
X_THREAD_MAX_AGE_HOURS=36
X_THREAD_REFETCH_MINUTES=30,180,720
X_COLLECT_QUOTES=false
X_THREAD_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Instagram collector (workers/ig_collector/) — experimental, read-only
# Use --mock for offline fixtures. Live automated reads may violate terms or
# trigger account restrictions; prefer Meta Graph API for owned customer accounts.
# ---------------------------------------------------------------------------
# Set hikerapi or instaloader before enabling the optional Instagram worker.
IG_BACKEND=
IG_SEEDS_FILE=data/ig_seeds.json
HIKERAPI_KEY=
IG_INSTALOADER_SESSION_FILE=
IG_PROXY_URL=
IG_COLLECT_OUTPUT_DIR=data/ig_collected
IG_COLLECT_STATE_FILE=output/ig_collector_state.sqlite3
IG_COLLECT_DAILY_CAP=100
IG_COLLECT_SLEEP_MIN=12
IG_COLLECT_SLEEP_MAX=25
IG_COLLECT_CIRCUIT_BREAKER=3
IG_COLLECT_MAX_RETRIES=2
IG_COLLECT_INTERVAL_SECONDS=900
IG_CYCLE_MINUTES=60
IG_PAGE_CHANGES_PER_HOUR=30
IG_MAX_HANDLES_PER_CYCLE=20
IG_MAX_POSTS_PER_RUN=5
IG_MAX_COMMENTS_PER_POST=30
IG_MIN_INTENT_SCORE=1

# پنل و مدیریت queryهای X (پیش‌فرض خاموش)
# ارزیابی حقوقی/شرایط استفاده را پیش از فعال‌سازی انجام دهید. لینک‌های bio واکشی نمی‌شوند.

# ── Instagram session lifecycle ─────────────────────────────────────────────
# Mirror of each account session (0600 files, volume appdata). The database copy stays primary.
INSTAGRAM_SESSION_DIR=/app/data/instagram_sessions
# Credential re-login ONLY when Instagram rejects the saved session (login_required). Off = pause the account and
# wait for a fresh sessionid from the dashboard. Challenges / rate limits / network errors never trigger a login.
INSTAGRAM_SESSION_AUTO_REAUTH_ENABLED=true
INSTAGRAM_SESSION_MAX_RECOVERY_ATTEMPTS=1
INSTAGRAM_SESSION_RECOVERY_COOLDOWN_SECONDS=21600
INSTAGRAM_NETWORK_MAX_RETRIES=3
INSTAGRAM_NETWORK_INITIAL_BACKOFF_SECONDS=2
INSTAGRAM_NETWORK_MAX_BACKOFF_SECONDS=60

# Git-ignored backup of the Instagram + X account pools (rewritten automatically; restore: manage.py accounts_pool import)
ACCOUNTS_POOL_FILE=/app/data/accounts_pool.json
