DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_DATABASE=sqlite
POSTGRES_DB=customer_yab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Standalone buyer discovery engine
USE_MOCK_SOURCES=true
X_ENABLED=false
X_BEARER_TOKEN=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest
XAI_TIMEOUT=30
GROK_BATCH_SIZE=25
MAX_GROK_REQUESTS=40
XAI_INPUT_USD_PER_MILLION_TOKENS=0
XAI_OUTPUT_USD_PER_MILLION_TOKENS=0
MAX_X_QUERIES=8
MAX_SOURCE_REQUESTS=100
MAX_TOTAL_RECORDS=3000
MAX_JOB_RUNTIME_SECONDS=300
DIVAR_ENABLED=false
DIVAR_API_KEY=
DIVAR_BASE_URL=https://open-api.divar.ir
DIVAR_SEARCH_ENDPOINT=/v2/open-platform/finder/post
DIVAR_TIMEOUT=30
DIVAR_MAX_REQUESTS_PER_JOB=30
DISCOVERY_CACHE_PATH=output/discovery_cache.sqlite3
VOCABULARY_CACHE_TTL=604800
JOB_STORE_PATH=output/jobs.sqlite3

# ---------------------------------------------------------------------------
# Shared analysis agent (analysis/)  — milestone 1 + 2
# ---------------------------------------------------------------------------
ANALYSIS_DB_PATH=data/analysis.sqlite3
# JSON file or Django agent feed URL (feed URL needs AGENT_API_TOKEN, milestone 3)
CATALOG_SOURCE=data/sample/catalog.json
AGENT_API_TOKEN=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# LLM provider — any OpenAI-compatible API (default: Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
TRIAGE_MODEL=llama-3.1-8b-instant
DEEP_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=45
LLM_MAX_RETRIES=3
# USD per 1M tokens as model:input:output — copy CURRENT prices from the provider's pricing page
MODEL_PRICES=llama-3.1-8b-instant:0.05:0.08,llama-3.3-70b-versatile:0.59:0.79
USD_TO_TOMAN=100000

# Funnel
TRIAGE_BATCH_SIZE=15
FIT_THRESHOLD=60
MAX_LLM_CALLS_PER_RUN=200
ANALYSIS_MAX_ATTEMPTS=3
REPLY_MAX_CHARS=600
CONTEXT_CHAR_BUDGET=2500

# ---------------------------------------------------------------------------
# Telegram crawler (telegram_crawler/) — get API_ID/HASH from https://my.telegram.org
# (the crawler reads this file and telegram_crawler/.env; full list in telegram_crawler/.env.example)
# ---------------------------------------------------------------------------
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/telegram_crawler_session
DB_PATH=data/leads.db
BACKFILL_HOURS=24
BACKFILL_LIMIT=200
CONTEXT_MSG_COUNT=5
CRAWLER_FILTER_MODE=basic
ANALYSIS_ENQUEUE_ENABLED=true
DJANGO_WEBHOOK_ENABLED=false
