DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_DATABASE=sqlite
POSTGRES_DB=customer_yab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Standalone buyer discovery engine
USE_MOCK_SOURCES=true
X_ENABLED=false
X_BEARER_TOKEN=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest
XAI_TIMEOUT=30
GROK_BATCH_SIZE=25
MAX_GROK_REQUESTS=40
MAX_X_QUERIES=8
MAX_SOURCE_REQUESTS=100
MAX_TOTAL_RECORDS=3000
MAX_JOB_RUNTIME_SECONDS=300
DIVAR_ENABLED=false
DIVAR_API_KEY=
DIVAR_BASE_URL=https://open-api.divar.ir
DIVAR_SEARCH_ENDPOINT=/v2/open-platform/finder/post
DIVAR_TIMEOUT=30
DIVAR_MAX_REQUESTS_PER_JOB=30
