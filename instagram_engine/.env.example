# ==============================================================================
# Instagram Lead Generation & Outreach Engine Configuration
# ==============================================================================

# Database Connection (PostgreSQL with psycopg2)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/customer_yab

# Multi-Tenancy
DEFAULT_TENANT_ID=tenant_default

# Local or Remote OpenAI-Compatible LLM (Ollama, vLLM, OpenRouter, or OpenAI)
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.3

# Operating Hours & Circadian Rhythm
TIMEZONE=Asia/Tehran
OUTREACH_START_HOUR=9
OUTREACH_END_HOUR=23

# Rate Limits & Pacing - Scraper Pool
SCRAPER_POST_SLEEP_MIN=10
SCRAPER_POST_SLEEP_MAX=25
SCRAPER_HASHTAG_SLEEP_MIN=45
SCRAPER_HASHTAG_SLEEP_MAX=120
MAX_SCRAPER_HASHTAGS_PER_HOUR=4
MAX_SCRAPER_HASHTAGS_PER_DAY=18
MAX_SCRAPER_POST_COMMENTS_PER_DAY=80

# Rate Limits & Pacing - Sender Pool
SENDER_DM_SLEEP_MIN=720
SENDER_DM_SLEEP_MAX=1500
SENDER_WARMING_MAX_DMS_PER_DAY=8
SENDER_ESTABLISHED_MAX_DMS_PER_DAY=20
LIKE_BEFORE_DM=true

# Storage directory for local session backups
SESSION_STORAGE_DIR=./sessions
